<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Pega.Desktop"
        x:Class="Pega.Desktop.MainWindow"
        Title="Pega" Icon="avares://Pega.Desktop/Assets/Pega.png"
        Width="1120" Height="760" MinWidth="760" MinHeight="590"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="230,*">
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Outline}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18,22,18,18">
                <StackPanel Orientation="Horizontal" Spacing="11" Margin="4,0,0,24">
                    <Image Width="38" Height="38" Source="avares://Pega.Desktop/Assets/Pega.png" />
                    <TextBlock Text="Pega" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Row="1" x:Name="NewChatButton" Classes="primary" Padding="12,10"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NewChatClicked">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <PathIcon Width="15" Height="15" Data="{StaticResource PlusIcon}" />
                        <TextBlock Text="New chat" />
                    </StackPanel>
                </Button>
                <Border Grid.Row="2" Padding="10,9" Margin="0,17,0,0" CornerRadius="8"
                        Background="#232530" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <PathIcon Data="{StaticResource ChatIcon}" Width="15" Height="15"
                                  Foreground="{StaticResource Muted}" />
                        <TextBlock Text="Current conversation" FontSize="13" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="3" Spacing="12">
                    <TextBlock Text="Learning profile" FontSize="13" FontWeight="SemiBold" Margin="3,0" />
                    <Border BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="11"
                            Background="{StaticResource Surface}" Padding="12">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock x:Name="ExampleCount" Text="—" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" x:Name="UpdateCount" Text="—" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="Examples" Classes="muted" FontSize="11" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Updates" Classes="muted" FontSize="11" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="SmolLM2 · 135M" Classes="muted" FontSize="11"
                                       Margin="0,12,0,0" />
                        </Grid>
                    </Border>
                    <Button x:Name="ResetLearningButton" Classes="quiet" Content="Reset learning…"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="9,6" FontSize="12" Click="ResetLearningClicked" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="62,*,Auto">
            <Border BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" Margin="26,0">
                    <TextBlock Text="Chat" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                    <Border Grid.Column="1" BorderBrush="{StaticResource Outline}" BorderThickness="1"
                            CornerRadius="20" Padding="10,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="WorkerDot" Width="6" Height="6" Fill="{StaticResource Muted}" />
                            <TextBlock x:Name="WorkerLabel" Text="Starting" Classes="muted" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="Transcript" IsVisible="False"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" Margin="26,28,26,24" Spacing="14">
                        <ItemsControl x:Name="Messages">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="18" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ChatLine">
                                    <Border Classes.user="{Binding IsUser}" Classes.reply="True"
                                            Padding="15,13" CornerRadius="12">
                                        <Border.Styles>
                                            <Style Selector="Border.reply.user">
                                                <Setter Property="Background" Value="{StaticResource Surface}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                            </Style>
                                        </Border.Styles>
                                        <Grid ColumnDefinitions="30,*">
                                            <Border Width="27" Height="27" VerticalAlignment="Top" CornerRadius="8"
                                                    Background="{StaticResource AccentSurface}" IsVisible="{Binding !IsUser}">
                                                <PathIcon Width="13" Height="13" Foreground="{StaticResource Accent}"
                                                          Data="{StaticResource PegaMark}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="5" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Speaker}" Classes="muted" FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <SelectableTextBlock Text="{Binding Content}" FontSize="15"
                                                                     TextWrapping="Wrap" LineHeight="23" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="FeedbackBar" IsVisible="False" Orientation="Horizontal"
                                    Spacing="8" Margin="53,-5,0,4">
                            <Button x:Name="ApproveButton" Classes="quiet" Padding="9,6"
                                    Click="ApproveClicked" ToolTip.Tip="Learn this reply as written">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource CheckIcon}" Width="12" Height="12"
                                              Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="ApproveLabel" Text="Approve" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CorrectButton" Classes="quiet" Padding="9,6" Click="CorrectClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource EditIcon}" Width="12" Height="12" />
                                    <TextBlock Text="Correct reply" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="22,0,22,12" Spacing="0">
                    <Border Width="78" Height="78" CornerRadius="24" HorizontalAlignment="Center"
                            BorderBrush="#404F35" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#35412B" Offset="0" />
                                <GradientStop Color="#202623" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <PathIcon Width="36" Height="36" Data="{StaticResource PegaMark}"
                                  Foreground="{StaticResource Accent}" />
                    </Border>
                    <TextBlock Text="What’s on your mind?" TextAlignment="Center"
                               FontSize="36" FontWeight="SemiBold" Margin="0,20,0,0" />
                    <TextBlock Text="Ask a question or teach Pega a better reply." TextAlignment="Center"
                               Classes="muted" FontSize="14" Margin="0,8,0,27" />
                    <Grid ColumnDefinitions="*,12,*" MaxWidth="480">
                        <Button x:Name="ExplainButton" Classes="suggestion" HorizontalAlignment="Stretch"
                                Click="SuggestionClicked" Tag="Explain how rainbows form in simple terms.">
                            <StackPanel Spacing="6">
                                <PathIcon Data="{StaticResource LightbulbIcon}" Width="16" Height="16"
                                          HorizontalAlignment="Left" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Explain a topic" FontSize="13" />
                                <TextBlock Text="How do rainbows form?" Classes="muted" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="PlanButton" Classes="suggestion" HorizontalAlignment="Stretch"
                                Click="SuggestionClicked" Tag="Help me plan an easy 20-minute dinner.">
                            <StackPanel Spacing="6">
                                <PathIcon Data="{StaticResource ChatIcon}" Width="16" Height="16"
                                          HorizontalAlignment="Left" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Plan something" FontSize="13" />
                                <TextBlock Text="Suggest a quick dinner" Classes="muted" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" MaxWidth="780" Margin="26,0,26,16" Spacing="8">
                <Border x:Name="ErrorPanel" IsVisible="False" Background="#352329" BorderBrush="#6E424C"
                        BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <SelectableTextBlock x:Name="ErrorText" Foreground="#F9C1C9" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <Border x:Name="ComposerPanel" Classes="composer" Background="{StaticResource Surface}"
                        BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="MessageInput" Classes="compose" PlaceholderText="Message Pega"
                                 AutomationProperties.Name="Message Pega" AcceptsReturn="True"
                                 MinHeight="32" MaxHeight="120" VerticalAlignment="Center"
                                 TextWrapping="Wrap" VerticalContentAlignment="Center" Margin="0,0,10,0"
                                 TextChanged="InputChanged" />
                        <Button Grid.Column="1" x:Name="SendButton" Classes="primary" Width="37" Height="37"
                                HorizontalContentAlignment="Center" VerticalAlignment="Bottom"
                                AutomationProperties.Name="Send message" ToolTip.Tip="Send message" Click="SendClicked">
                            <PathIcon Data="{StaticResource ArrowIcon}" Width="16" Height="16" />
                        </Button>
                    </Grid>
                </Border>
                <Border x:Name="CorrectionPanel" IsVisible="False" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="Teach a replacement reply" FontSize="13" FontWeight="SemiBold" />
                        <TextBox Grid.Row="1" x:Name="CorrectionInput" AutomationProperties.Name="Replacement reply"
                                 PlaceholderText="Write the reply you want Pega to learn" TextWrapping="Wrap"
                                 AcceptsReturn="True" MinHeight="50" MaxHeight="125" Margin="0,9,0,10"
                                 TextChanged="InputChanged" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="CancelCorrectionButton" Classes="quiet" Click="CancelCorrectionClicked"
                                    Padding="10,6" Content="Cancel" />
                            <Button x:Name="TeachButton" Classes="primary" Click="TeachClicked"
                                    Padding="11,6" Content="Teach correction" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                    <TextBlock x:Name="ActivityText" Text="Enter to send · Shift+Enter for a new line"
                               Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="On this device" Classes="muted" FontSize="11" Margin="12,0,0,0" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
